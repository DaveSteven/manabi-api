  "components": {
    "schemas": {
      "AnswerIn": {
        "properties": {
          "option_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "title": "Option Id"
          },
          "elapsed_ms": {
            "type": "integer",
            "maximum": 86400000.0,
            "minimum": 0.0,
            "title": "Elapsed Ms",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "option_id"
        ],
        "title": "AnswerIn"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "ExamOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "level": {
            "type": "string",
            "title": "Level"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "month": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Month"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "level",
          "year",
          "month"
        ],
        "title": "ExamOut"
      },
      "ExamsOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExamOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "ExamsOut"
      },
      "FeedbackOut": {
        "properties": {
          "chosen_option_id": {
            "type": "string",
            "title": "Chosen Option Id"
          },
          "correct_option_id": {
            "type": "string",
            "title": "Correct Option Id"
          },
          "is_correct": {
            "type": "boolean",
            "title": "Is Correct"
          },
          "explanation": {
            "$ref": "#/components/schemas/RichText"
          },
          "explanation_available": {
            "type": "boolean",
            "title": "Explanation Available"
          },
          "translation": {
            "$ref": "#/components/schemas/RichText"
          },
          "subtitles": {
            "items": {
              "$ref": "#/components/schemas/SubtitleOut"
            },
            "type": "array",
            "title": "Subtitles"
          },
          "answered_at": {
            "type": "string",
            "title": "Answered At"
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms"
          }
        },
        "type": "object",
        "required": [
          "chosen_option_id",
          "correct_option_id",
          "is_correct",
          "explanation",
          "explanation_available",
          "translation",
          "subtitles",
          "answered_at",
          "elapsed_ms"
        ],
        "title": "FeedbackOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "position": {
            "type": "integer",
            "title": "Position"
          },
          "question": {
            "$ref": "#/components/schemas/QuestionOut"
          },
          "feedback": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FeedbackOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "position",
          "question",
          "feedback"
        ],
        "title": "ItemOut"
      },
      "LevelOut": {
        "properties": {
          "level": {
            "type": "string",
            "title": "Level"
          },
          "question_count": {
            "type": "integer",
            "title": "Question Count"
          },
          "exam_count": {
            "type": "integer",
            "title": "Exam Count"
          }
        },
        "type": "object",
        "required": [
          "level",
          "question_count",
          "exam_count"
        ],
        "title": "LevelOut"
      },
      "LevelsOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LevelOut"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "LevelsOut"
      },
      "MaterialOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
